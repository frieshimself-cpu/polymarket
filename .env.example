# ── Oracle brain ─────────────────────────────────────────────────────────────
# Claude API key. With this set, Claude analyzes the markets and writes the
# signals. Without it, the site still works in clearly-labeled QUANT mode.
ANTHROPIC_API_KEY=

# Optional: override the model the oracle runs on.
CLAUDE_MODEL=claude-opus-4-8

# ── Token ($PREDICTIONS) ─────────────────────────────────────────────────────
# Paste the pump.fun contract address here the moment you have it.
# Until it's set, the site shows "CA DROPS SOON".
NEXT_PUBLIC_TOKEN_CA=

# Where the BUY buttons point. Set this to your pump.fun coin URL on launch.
NEXT_PUBLIC_PUMPFUN_URL=

# ── Socials (leave empty to show "TBA") ──────────────────────────────────────
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
